# The scripts read the database connection from the PREM_DB_URL environment variable.
# Set it once in PowerShell (then open a new terminal):
#   setx PREM_DB_URL "postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/prem_sims"
PREM_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/prem_sims
